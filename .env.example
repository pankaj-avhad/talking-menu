PEXELS_API_KEY=
BOSON_API_KEY=

# The restaurant's own phone line (E.164, e.g. +14155550123). Calls the AI
# hands off ring here once phone calls go through Twilio.
STAFF_PHONE_NUMBER=

# Optional relay settings (defaults shown)
# RELAY_PORT=8787
# AGENT_VOICE=chloe                 # chloe, eleanor, nora, jake, marcus, oliver or default
# AGENT_TURN_DETECTION=server_vad   # or semantic_vad (ends turns sooner; split sentences in testing)
# AGENT_SILENCE_MS=500              # pause that ends the caller's turn (server_vad)
# PUBLIC_APP_URL=                   # where order links point; default: the page that opened the call
# RELAY_ALLOWED_ORIGINS=            # sites allowed to start calls; default: any http://localhost page
# DELIVERY_FEE_CENTS=0
# MAX_BROWSER_CALLS=2
# MAX_CALL_MINUTES=15

# Where the call page finds the relay (read at build time)
# NEXT_PUBLIC_RELAY_URL=ws://localhost:8787/browser
