{
  "name": "talking-menu",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "relay": "node --env-file-if-exists=.env --import tsx relay/server.ts",
    "relay:dev": "node --env-file-if-exists=.env --import tsx --watch relay/server.ts",
    "dev:all": "concurrently --names web,relay --prefix-colors blue,magenta \"npm:dev\" \"npm:relay:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "fill-images": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/fill-images.ts",
    "simulate-call": "node --env-file-if-exists=.env --import tsx scripts/simulate-call.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"relay/**/*.test.ts\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
